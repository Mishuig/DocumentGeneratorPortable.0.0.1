<Window x:Class="DocumentGenerator.SaveChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Збереження документа" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,24">
            <TextBlock Text="Збереження документа" Style="{StaticResource DialogTitle}"/>
            <TextBlock Text="Як зберегти документ?" Style="{StaticResource DialogSubtitle}" Margin="0,4,0,20"/>

            <!-- Обидві картки — однакові стилі, без зовнішніх Margin => однакова ширина -->
            <Button Click="AutoName_Click" Style="{StaticResource OptionCardButton}" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="📄" FontSize="20" Width="32"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Зберегти зі згенерованою назвою" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="AutoNamePreview" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button Click="CustomName_Click" Style="{StaticResource OptionCardButton}">
                <DockPanel MinHeight="40">
                    <TextBlock DockPanel.Dock="Left" Text="📝" FontSize="20" Width="32"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Обрати назву файлу самостійно" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextMain}"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </StackPanel>

        <!-- «Скасувати» — вторинна кнопка, праворуч, тих самих розмірів, що й в інших діалогах -->
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <Button Content="Скасувати" IsCancel="True" Click="Cancel_Click" HorizontalAlignment="Right"
                    Style="{StaticResource DialogSecondaryButton}"/>
        </Border>
    </Grid>
</Window>
