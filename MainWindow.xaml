<Window x:Class="DocumentGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuGen" Height="820" Width="1280"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#E8EEF5">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0D9488"/>
        <SolidColorBrush x:Key="AccentDark" Color="#0F766E"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#CCFBF1"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="Success" Color="#059669"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Success}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#99F6E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0FDFA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#CCFBF1" Margin="0,0,10,0">
                        <TextBlock Text="✎" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0D9488"/>
                    </Border>
                    <TextBlock Text="DocuGen" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Імпортувати DOCX" Click="ImportTemplate_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Резервна копія" Click="Backup_Click" Style="{StaticResource GhostButton}"/>
                    <Button Content="Оновити" Click="Refresh_Click" Style="{StaticResource GhostButton}" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left library -->
            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="16"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Бібліотека шаблонів" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBox x:Name="SearchBox" Margin="0,10,0,6"
                                 ToolTip="Пошук за назвою або категорією"
                                 TextChanged="SearchBox_TextChanged"
                                 Tag="search">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="Оберіть шаблон зі списку" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                    <ListBox x:Name="TemplatesList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TemplatesList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#F8FAFC" CornerRadius="10" Padding="12,10"
                                                    BorderBrush="Transparent" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F0FDFA"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#99F6E4"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✎"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Перейменувати шаблон"
                                            Click="TemplateRenamePencil_Click"
                                            Tag="{Binding}"
                                            Foreground="#0D9488"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="#0F172A" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right form -->
            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="SelectedTemplateTitle" Text="Оберіть шаблон"
                                   FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TemplateInfo"
                                   Text="Після імпорту DOCX тут з'явиться інформація про змінні."
                                   Foreground="#64748B" Margin="0,4,0,8" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FieldsPanel"
                                    AllowDrop="True"
                                    Drop="FieldsPanel_Drop"
                                    DragOver="FieldsPanel_DragOver">
                            <TextBlock Text="Поля шаблону з'являться тут." Foreground="#94A3B8"/>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Row="3" Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Content="Видалити шаблон" Click="Delete_Click"
                                Foreground="#DC2626" Background="#FEF2F2" Margin="0"/>
                        <WrapPanel>
                            <Button Content="Відкрити шаблон" Click="OpenTemplate_Click" Style="{StaticResource GhostButton}"/>
                            <Button Content="Очистити поля" Click="ClearFields_Click" Style="{StaticResource GhostButton}"/>
                            <Button Content="Перегляд" Click="Preview_Click" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Зберегти документ" Click="Generate_Click" Style="{StaticResource SuccessButton}" Margin="0"/>
                        </WrapPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="20,0,20,12"
                   Text="Portable mode • кириличні змінні • перетягування полів • значення запам'ятовуються"
                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</Window>
