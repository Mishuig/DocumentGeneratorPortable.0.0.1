<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================================================================
         ЄДИНА ТЕМА ЗАСТОСУНКУ
         Правила кольорів кнопок (діють у всіх вікнах):
           PrimaryButton   — одна головна позитивна дія у вікні (Зберегти, Створити)
           TonalButton     — додаткова позитивна дія (Імпортувати DOCX)
           SecondaryButton — нейтральна: Скасувати, Закрити, Перегляд, Відкрити…
           DangerButton    — небезпечна дія (контурна, у формі); потребує підтвердження
           DangerSolidButton — лише кнопка підтвердження у діалозі видалення
         Сітка відступів: 4 / 8 / 12 / 16 / 24 px.
         =================================================================== -->

    <!-- Палітра -->
    <SolidColorBrush x:Key="Accent"        Color="#0F766E"/>   <!-- teal-700: контраст 5.5:1 з білим текстом -->
    <SolidColorBrush x:Key="AccentHover"   Color="#115E59"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#134E4A"/>
    <SolidColorBrush x:Key="AccentBrand"   Color="#0D9488"/>   <!-- іконки, виділення -->
    <SolidColorBrush x:Key="AccentSoft"    Color="#CCFBF1"/>
    <SolidColorBrush x:Key="AccentTint"    Color="#F0FDFA"/>
    <SolidColorBrush x:Key="AccentBorder"  Color="#99F6E4"/>

    <SolidColorBrush x:Key="DangerFg"      Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerBorder"  Color="#FCA5A5"/>
    <SolidColorBrush x:Key="DangerTint"    Color="#FEF2F2"/>
    <SolidColorBrush x:Key="DangerSolid"   Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSolidHover" Color="#B91C1C"/>

    <SolidColorBrush x:Key="PanelBg"       Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBg"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderSoft"    Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStrong"  Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HoverBg"       Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextMain"      Color="#0F172A"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#64748B"/>

    <!-- Значення за замовчуванням для адаптивних ресурсів.
         Головне вікно перевизначає їх у коді (MainWindow.Responsive.cs). -->
    <sys:Double x:Key="FsBase">13</sys:Double>
    <sys:Double x:Key="FsSmall">12</sys:Double>
    <sys:Double x:Key="BtnH">40</sys:Double>
    <sys:Double x:Key="IconSize">28</sys:Double>
    <Thickness x:Key="BtnPad">14,8,14,8</Thickness>
    <Thickness x:Key="InputPad">12,10,12,10</Thickness>

    <!-- ===================== КНОПКИ ===================== -->
    <!-- База: однакова висота, однакова рамка 1px у ВСІХ варіантів, без зовнішніх Margin -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="{DynamicResource BtnPad}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
        <Setter Property="Height" Value="{DynamicResource BtnH}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrand}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BorderSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Нейтральна / другорядна -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

    <!-- Головна дія (єдина залита акцентна кнопка у вікні) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Застарілий ключ: тепер збігається з Primary, щоб не було «випадкових» зелених -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>

    <!-- Додаткова позитивна дія (світла акцентна) -->
    <Style x:Key="TonalButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentTint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBorder}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Небезпечна дія: контурна, ті самі розміри і рамка, що й у решти -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerFg}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerTint}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FEE2E2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Підтвердження видалення (тільки у діалозі) -->
    <Style x:Key="DangerSolidButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerSolid}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerSolid}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerSolidHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerSolidHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Кнопки модальних вікон: фіксовано 36px × мін. 120px, щоб усі діалоги були однакові -->
    <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DangerSolidButton}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Іконкові кнопки (✎ ▲ ▼) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource IconSize}"/>
        <Setter Property="MinWidth" Value="{DynamicResource IconSize}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ПОЛЯ ВВОДУ ===================== -->
    <!-- Поле форми головного вікна (м'ята підкладка) -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="{DynamicResource InputPad}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource AccentTint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поле у модальних вікнах: біле, однорядкове, фіксована висота 38 -->
    <Style x:Key="DialogInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ===================== ТЕКСТ ДІАЛОГІВ ===================== -->
    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    </Style>
    <Style x:Key="DialogSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DialogLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Нижня панель кнопок діалогу: однакова у всіх вікнах -->
    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="24,16"/>
    </Style>

    <!-- Картка-варіант у діалозі вибору (кнопка на всю ширину) -->
    <Style x:Key="OptionCardButton" TargetType="Button">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
