<Window x:Class="DocumentGenerator.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підтвердження" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="24">
            <Border DockPanel.Dock="Left" x:Name="IconBox" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource DangerTint}" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock x:Name="IconText" Text="⚠" FontSize="20" Foreground="{StaticResource DangerSolid}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource DialogSubtitle}" Margin="0,8,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="0" Content="Скасувати" IsCancel="True"
                        Style="{StaticResource DialogSecondaryButton}"/>
                <Button x:Name="ConfirmButton" Grid.Column="2" Click="Confirm_Click"
                        Style="{StaticResource DialogPrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
