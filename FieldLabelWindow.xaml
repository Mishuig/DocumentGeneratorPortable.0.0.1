<Window x:Class="DocumentGenerator.FieldLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування поля форми" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,24">
            <TextBlock Text="Редагування поля форми" Style="{StaticResource DialogTitle}" Margin="0,0,0,20"/>

            <TextBlock Text="Відображувана назва поля" Style="{StaticResource DialogLabel}"/>
            <TextBox x:Name="LabelBox" Style="{StaticResource DialogInput}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Скасувати" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource DialogSecondaryButton}"/>
                <Button Grid.Column="2" Content="Зберегти" IsDefault="True" Click="Save_Click"
                        Style="{StaticResource DialogPrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
